# Copy to /opt/starmeet/star-meet-backend/.moments.env on production.
# Keep the resulting file mode 600; it is intentionally ignored by git/Docker.
# MOMENTS_DB_PASS is optional when using run-publish-moments.sh: the wrapper
# reads DATABASE_PASSWORD from the running API container when it is omitted.
MOMENTS_DB_USER=root
MOMENTS_DB_NAME=star_meet
MOMENTS_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
MOMENTS_OSS_BUCKET_NAME=star-meet
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OpenAI-compatible LLM used for daily moment copy generation.
MOMENTS_LLM_BASE_URL=https://ai98pro.xyz/v1
MOMENTS_LLM_API_KEY=
MOMENTS_LLM_MODEL=grok-4.6
# Content language/market used by the publisher.
MOMENTS_LOCALE=zh-Hant-TW
PEXELS_API_KEY=

# Legacy fallback only. Remove after all publishing hosts are migrated.
# DASHSCOPE_API_KEY=
# Daily moment slots use Taiwan time.
MOMENTS_TZ=Asia/Taipei
# Maximum number of due characters processed per run. The recommended cron
# schedule runs every 10 minutes during the 08:00-22:00 publish window.
MOMENTS_MAX_PER_RUN=20
