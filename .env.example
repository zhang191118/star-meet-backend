# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=star_meet
DB_USER=root
DB_PASSWORD=your_password_here

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT配置
JWT_SECRET=your_jwt_secret_here

# 邮件配置
SMTP_HOST=smtp.163.com
SMTP_PORT=587
SMTP_USER=your_email@163.com
SMTP_PASSWORD=your_email_password

# Apple Push Notification service (optional; use the .p8 file path in production)
APNS_KEY_ID=your_apple_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_TOPIC=com.yourcompany.starmeet
APNS_ENVIRONMENT=production
APNS_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# Docker Compose host path (the container always reads /run/secrets/apns/AuthKey.p8)
APNS_PRIVATE_KEY_FILE=./secrets/AuthKey_XXXXXXXXXX.p8

# AI服务配置
MINIMAX_API_KEY=your_minimax_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key
MEM0_API_KEY=your_mem0_api_key

# 阿里云配置
OSS_ACCESS_KEY_ID=your_oss_key_id
OSS_ACCESS_KEY_SECRET=your_oss_key_secret

# Optional Zhipu vector-memory embeddings; do not reuse a MiniMax chat key.
EMBEDDING_API_KEY=your_zhipu_embedding_api_key
