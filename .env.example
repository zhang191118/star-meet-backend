# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=star_meet
DB_USER=root
DB_PASSWORD=your_password_here

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
